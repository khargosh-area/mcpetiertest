# ── Discord bot ───────────────────────────────────────────────────────────────
# Required for the bot to log in. Never commit real tokens.
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Password for the control panel (https://your-app.vercel.app/login)
DASHBOARD_PASSWORD=change-me
# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Set to "true" to allow the dashboard to start/stop bot sessions on Vercel.
DASHBOARD_CONTROL=true

# ── Storage (pick ONE) ────────────────────────────────────────────────────────
# Any Postgres works: Neon, Supabase, Vercel Postgres, Railway, Timescale...
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# POSTGRES_URL=postgresql://user:password@host/db?sslmode=require

# ── Optional ──────────────────────────────────────────────────────────────────
# Used by the Deploy page to show live Vercel deployment status.
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
# Where the bot runner writes its logs / state when no database is configured.
# DATA_DIR=./data
